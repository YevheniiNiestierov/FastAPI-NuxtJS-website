# PostgreSQL (used by docker-compose)
POSTGRES_USER=soap
POSTGRES_PASSWORD=change_me
POSTGRES_DB=soap

# Backend database URL (for running outside docker; compose builds its own)
DATABASE_URL=postgresql+psycopg2://soap:change_me@localhost:5432/soap

# Auth
JWT_SECRET_KEY=change_me

# Initial admin user
ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me

# Telegram bot
BOT_API_TOKEN=
CHAT_ID=

# AWS S3
AWS_S3_ACCESS_KEY_ID=
AWS_S3_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=

