# ─── Copy this file to app/.env and fill in real values ───────────────────────
# The root-level .env is no longer needed — all secrets live in app/.env,
# which is loaded by Docker Compose (env_file: ./app/.env) and by the app itself.

# ── Telegram Bot ───────────────────────────────────────────────────────────────
BOT_API_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_ID=123456789

# ── AWS DynamoDB ───────────────────────────────────────────────────────────────
AWS_DYNAMODB_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_DYNAMODB_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_DYNAMODB_REGION_NAME=eu-north-1

# ── AWS S3 ─────────────────────────────────────────────────────────────────────
AWS_S3_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_S3_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_REGION_NAME=eu-north-1
AWS_S3_BUCKET_NAME=your-bucket-name

# ── Auth / JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-long-random-secret

# ── Seed admin account (used by create_admin.py / lifespan seeding) ────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com

